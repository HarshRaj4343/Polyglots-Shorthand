{
  "notebook": "02_teacher_kd",
  "description": "Phase 3 teacher v2: hing-roberta-mixed (Phase 1 winner) on v1.1 train + generated support data (+ augmented variants) + 4,000 public sentiment rows (intent masked). Stage 1 (public-only pre-fine-tuning) skipped for time. Selection by v1.1 validation NLL. Produces logits for KD.",
  "candidates": ["l3cube-pune/hing-roberta-mixed"],
  "learning_rates": [3e-5, 5e-5],
  "train_files": [
    {"path": "data/v11/train.jsonl", "intent": true, "sentiment": true},
    {"path": "data/gen/gen_v12.jsonl", "intent": true, "sentiment": true},
    {"path": "data/kd/aug_train.jsonl", "intent": true, "sentiment": true},
    {"path": "data/public/sentiment_labeled.jsonl", "intent": false, "sentiment": true, "sample": 4000}
  ],
  "validation_file": "data/v11/validation.jsonl",
  "predict_files": {
    "validation": "data/v11/validation.jsonl",
    "test": "data/v11/test.jsonl",
    "test_stress": "data/v11/test_stress.jsonl",
    "audit": "data/v11/audit.jsonl",
    "contrast": "data/contrast.jsonl",
    "human_test": "data/human_test.jsonl",
    "kd_train": "data/v11/train.jsonl",
    "kd_gen": "data/gen/gen_v12.jsonl",
    "kd_aug": "data/kd/aug_train.jsonl",
    "kd_public_labeled": "data/public/sentiment_labeled.jsonl",
    "kd_pool": "data/public/unlabeled_pool.jsonl"
  },
  "max_epochs": 6,
  "patience": 2,
  "batch_size": 32,
  "max_length": 128,
  "warmup_ratio": 0.06,
  "weight_decay": 0.01,
